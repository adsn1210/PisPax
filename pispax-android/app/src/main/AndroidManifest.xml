<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- OSMDroid: caché de tiles del mapa -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".PispaxApplication"
        android:allowBackup="true"
        android:icon="@drawable/logo_naranja"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_naranja"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pispax"
        android:usesCleartextTraffic="true">

        <!-- PANTALLAS DE AUTENTICACIÓN (acceso libre, sin sesión) -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Pispax.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.RegistroActivity"
            android:exported="false" />

        <!-- PANTALLAS DE CLIENTE -->
        <activity
            android:name=".ui.cliente.HomeClienteActivity"
            android:exported="false" />
        <activity
            android:name=".ui.cliente.CrearViajeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.cliente.MisViajesClienteActivity"
            android:exported="false" />

        <!-- PANTALLAS DE TRANSPORTISTA -->
        <activity
            android:name=".ui.transportista.HomeTransportistaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.transportista.ViajesDisponiblesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.transportista.MisViajesTransportistaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.transportista.MisVehiculosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.transportista.CrearVehiculoActivity"
            android:exported="false" />

        <!-- PANTALLAS COMPARTIDAS (ambos roles) -->
        <activity
            android:name=".ui.shared.DetalleViajeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.shared.MapaViajeActivity"
            android:exported="false" />

    </application>

</manifest>
