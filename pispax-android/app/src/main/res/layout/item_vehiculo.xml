<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_vehiculo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/bg_card"
    android:layout_marginBottom="@dimen/card_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_vehiculo_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Renault Master · 1234ABC"
                android:textColor="@color/texto_primario"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_tipo_vehiculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Furgón Grande"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/tv_capacidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1500 kg"
                    android:textColor="@color/naranja_principal"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ·  "
                    android:textColor="@color/divider"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_carnet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carnet B"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_seleccionado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:buttonTint="@color/naranja_principal" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
