<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="1dp">

    <!-- Columna izquierda: punto + línea -->
    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/view_dot"
            android:layout_width="@dimen/timeline_dot_size"
            android:layout_height="@dimen/timeline_dot_size"
            android:background="@drawable/dot_estado_pendiente"
            android:layout_marginTop="2dp" />

        <View
            android:id="@+id/view_line"
            android:layout_width="@dimen/timeline_line_width"
            android:layout_height="36dp"
            android:background="@color/divider"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Columna derecha: etiqueta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingBottom="2dp"
        android:gravity="center_vertical"
        android:minHeight="22dp">

        <TextView
            android:id="@+id/tv_estado_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_estado_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/naranja_principal"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
