<?xml version="1.0" encoding="utf-8"?>
<!--
    MIS VIAJES TRANSPORTISTA — Lista de viajes asignados al transportista.
    Mismo diseño que Mis Viajes Cliente.

    ELEMENTOS MODIFICABLES ESTÉTICAMENTE:
    - tv_titulo_trans    → Título
    - rv_viajes_trans    → RecyclerView
    - tv_sin_viajes_trans→ Estado vacío
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_principal">

    <!-- TOOLBAR -->
    <!-- MODIFICAR: color de fondo, paddingTop para status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/navy_secundario"
        android:paddingStart="8dp"
        android:paddingEnd="@dimen/padding_normal"
        android:paddingTop="40dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_volver"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="22dp"
            app:iconTint="@color/blanco" />

        <TextView
            android:id="@+id/tv_titulo_trans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis viajes"
            android:textColor="@color/blanco"
            android:textSize="19sp"
            android:fontFamily="sans-serif-bold" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_viajes_trans"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/naranja_principal"
        android:layout_gravity="center"
        android:layout_marginTop="32dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_viajes_trans"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/padding_large"
        android:paddingTop="@dimen/padding_normal"
        android:paddingBottom="@dimen/padding_normal"
        android:clipToPadding="false" />

    <!-- ESTADO VACÍO -->
    <!-- MODIFICAR: texto del estado vacío -->
    <TextView
        android:id="@+id/tv_sin_viajes_trans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No tienes viajes asignados"
        android:textColor="@color/texto_secundario"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="@dimen/padding_large"
        android:visibility="gone" />

</LinearLayout>
