<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_viaje"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/bg_card"
    android:layout_marginBottom="@dimen/card_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Línea lateral de acento (color según estado) -->
        <View
            android:id="@+id/view_accent_line"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/naranja_principal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="13dp">

            <!-- Fila: tipo mercancía + badge estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tv_mercancia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Paquetería general"
                    android:textColor="@color/texto_primario"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Badge: esquinas redondeadas aplicadas vía GradientDrawable en el Adapter -->
                <TextView
                    android:id="@+id/tv_estado_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendiente"
                    android:textSize="11sp"
                    android:textColor="@color/estado_pendiente_text"
                    android:background="@color/estado_pendiente_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <!-- Ruta resumida -->
            <TextView
                android:id="@+id/tv_ruta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Origen → Destino"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Fila: peso + fecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp">

                <TextView
                    android:id="@+id/tv_peso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="480 kg"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_fecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03/06/2026"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
