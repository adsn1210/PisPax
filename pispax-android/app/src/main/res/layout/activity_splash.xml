<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_secundario">

    <!-- Logo centrado verticalmente en el 44% superior -->
    <LinearLayout
        android:id="@+id/layout_splash_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/logo_naranja"
            android:contentDescription="PisPax logo"
            android:scaleType="fitCenter" />

        <!-- Línea naranja como acento de marca -->
        <View
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="@color/naranja_principal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transporte inteligente"
            android:textColor="#70FFFFFF"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
