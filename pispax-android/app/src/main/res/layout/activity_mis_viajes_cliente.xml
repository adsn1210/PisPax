<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_principal">

    <!-- TOOLBAR NAVY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/navy_secundario"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/padding_large"
        android:paddingTop="40dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_volver"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="22dp"
            app:iconTint="@color/blanco" />

        <TextView
            android:id="@+id/tv_titulo_lista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis viajes"
            android:textColor="@color/blanco"
            android:textSize="19sp"
            android:fontFamily="sans-serif-bold" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_mis_viajes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/naranja_principal"
        android:layout_gravity="center"
        android:layout_marginTop="32dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mis_viajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/padding_large"
        android:paddingTop="@dimen/padding_normal"
        android:paddingBottom="@dimen/padding_normal"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tv_sin_viajes_lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No tienes viajes registrados"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="@dimen/padding_large"
        android:visibility="gone" />

</LinearLayout>
