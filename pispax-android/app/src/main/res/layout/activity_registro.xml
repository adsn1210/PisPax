<?xml version="1.0" encoding="utf-8"?>
<!--
    REGISTRO SCREEN — Formulario de creación de cuenta.
    Diseño de scroll vertical limpio, misma card blanca que el login.

    ELEMENTOS MODIFICABLES ESTÉTICAMENTE:
    - tv_registro_titulo → Título de la pantalla
    - til_*              → Campos de texto (estilo en themes.xml)
    - rg_rol             → Selector de rol (RadioGroup): apariencia de los RadioButton
    - btn_registro       → Botón de acción principal
    - tv_ya_cuenta       → Enlace de vuelta al login
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_principal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_large">

        <!-- LOGO -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logo_naranja"
            android:contentDescription="PisPax logo"
            android:scaleType="fitCenter"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- FLECHA ATRÁS + TÍTULO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_volver"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="22dp"
                app:iconTint="@color/naranja_principal" />

            <!-- TÍTULO DE PANTALLA -->
            <!-- MODIFICAR: textSize, fontFamily, color del título -->
            <TextView
                android:id="@+id/tv_registro_titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/registro_titulo"
                android:textColor="@color/texto_primario"
                android:textSize="@dimen/text_title"
                android:fontFamily="sans-serif-bold" />

            <!-- TOGGLE TEMA -->
            <!-- MODIFICAR: posición/icono del toggle de tema -->
            <ImageButton
                android:id="@+id/btn_toggle_tema"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_dark_mode"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:contentDescription="Cambiar tema" />

        </LinearLayout>

        <!-- CARD DEL FORMULARIO -->
        <!-- MODIFICAR: cardCornerRadius y cardElevation para el estilo de la card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- CAMPO NOMBRE -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_nombre"
                    style="@style/Widget.Pispax.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/registro_nombre_hint">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_nombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/texto_primario" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CAMPO APELLIDOS -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_apellidos"
                    style="@style/Widget.Pispax.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/registro_apellidos_hint"
                    android:layout_marginTop="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_apellidos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/texto_primario" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CAMPO EMAIL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_email"
                    style="@style/Widget.Pispax.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/registro_email_hint"
                    android:layout_marginTop="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/texto_primario" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CAMPO CONTRASEÑA -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_reg_password"
                    style="@style/Widget.Pispax.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/registro_password_hint"
                    android:layout_marginTop="12dp"
                    app:passwordToggleEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_reg_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/texto_primario" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CAMPO TELÉFONO (opcional) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_telefono"
                    style="@style/Widget.Pispax.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/registro_telefono_hint"
                    android:layout_marginTop="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_telefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textColor="@color/texto_primario" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIPO DE CUENTA"
                    android:textColor="@color/texto_secundario"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_rol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- RADIOBUTTON CLIENTE -->
                    <!-- MODIFICAR: apariencia, padding, color de selección -->
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_cliente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/registro_rol_cliente"
                        android:textColor="@color/texto_primario"
                        android:checked="true"
                        app:buttonTint="@color/naranja_principal" />

                    <!-- RADIOBUTTON TRANSPORTISTA -->
                    <!-- MODIFICAR: apariencia, padding, color de selección -->
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_transportista"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/registro_rol_transportista"
                        android:textColor="@color/texto_primario"
                        app:buttonTint="@color/naranja_principal" />

                </RadioGroup>

                <!-- BOTÓN CREAR CUENTA -->
                <!-- MODIFICAR: estilo del botón principal en themes.xml -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_registro"
                    style="@style/Widget.Pispax.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_altura"
                    android:text="@string/registro_btn"
                    android:layout_marginTop="24dp" />

                <!-- INDICADOR DE CARGA -->
                <ProgressBar
                    android:id="@+id/progress_registro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:indeterminateTint="@color/naranja_principal"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp" />

                <!-- ENLACE A LOGIN -->
                <!-- MODIFICAR: textSize, color, márgenes -->
                <TextView
                    android:id="@+id/tv_ya_cuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/registro_ya_cuenta"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:padding="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
