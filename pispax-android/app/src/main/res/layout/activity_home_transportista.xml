<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_principal">

    <!-- HEADER NAVY -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/navy_secundario"
        android:paddingStart="@dimen/padding_large"
        android:paddingEnd="@dimen/padding_normal"
        android:paddingTop="44dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/logo_naranja"
                android:contentDescription="PisPax logo"
                android:scaleType="fitCenter"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_saludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hola, transportista"
                    android:textColor="@color/blanco"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/tv_subtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Listo para trabajar?"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_toggle_tema"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_dark_mode"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:contentDescription="Cambiar tema" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cerrar_sesion"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconSize="18dp"
                app:iconTint="#60FFFFFF"
                android:text="Salir"
                android:textColor="#60FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- CONTENIDO SCROLLABLE -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="152dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_large"
            android:paddingBottom="80dp">

            <!-- Card CTA principal: flota sobre el header -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/bg_card"
                android:layout_marginTop="-24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/padding_large"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_disponibles"
                        style="@style/Widget.Pispax.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Ver viajes disponibles"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mis_viajes"
                            style="@style/Widget.Pispax.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Mis viajes"
                            android:textSize="14sp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_vehiculos"
                            style="@style/Widget.Pispax.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:text="Mis vehículos"
                            android:textSize="14sp"
                            android:layout_marginStart="6dp" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sección: viajes en curso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_en_curso_titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="En curso"
                    android:textColor="@color/texto_primario"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/btn_ver_todos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver todos"
                    android:textColor="@color/naranja_principal"
                    android:textSize="14sp"
                    android:padding="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_viajes_en_curso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_sin_viajes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin viajes asignados"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_viajes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:indeterminateTint="@color/naranja_principal"
                android:layout_gravity="center"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
