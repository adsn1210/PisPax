<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_principal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOOLBAR NAVY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/navy_secundario"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/padding_large"
            android:paddingTop="40dp"
            android:paddingBottom="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_volver"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="22dp"
                app:iconTint="@color/blanco" />

            <TextView
                android:id="@+id/tv_titulo_viaje"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Viaje #—"
                android:textColor="@color/blanco"
                android:textSize="19sp"
                android:fontFamily="sans-serif-bold" />

            <!-- Badge de estado en la barra (grande, pill) -->
            <TextView
                android:id="@+id/tv_estado_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendiente"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/estado_pendiente_text"
                android:background="@color/estado_pendiente_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />

        </LinearLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_large">

            <!-- CARD: RUTA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/bg_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Punto A: Recogida -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/dot_estado_activo"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RECOGIDA"
                                android:textColor="@color/texto_secundario"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:id="@+id/tv_ruta_recogida"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/texto_primario"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Línea de conexión vertical -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="16dp"
                        android:background="@color/divider"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Punto B: Entrega -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/dot_estado_completado"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ENTREGA"
                                android:textColor="@color/texto_secundario"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:id="@+id/tv_ruta_entrega"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/texto_primario"
                                android:textSize="14sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD: MERCANCÍA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/bg_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MERCANCÍA"
                            android:textColor="@color/texto_secundario"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_tipo_mercancia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/texto_primario"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="3dp" />

                        <TextView
                            android:id="@+id/tv_descripcion_mercancia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Peso destacado a la derecha -->
                    <TextView
                        android:id="@+id/tv_peso_detalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— kg"
                        android:textColor="@color/naranja_principal"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginStart="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD: PARTICIPANTES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/bg_card"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="4dp">

                    <!-- Fila participante -->
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">
                        <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                            android:text="Cliente" android:textColor="@color/texto_secundario"
                            android:textSize="12sp" android:letterSpacing="0.04" />
                        <TextView android:id="@+id/tv_cliente_nombre" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="—"
                            android:textColor="@color/texto_primario" android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">
                        <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                            android:text="Transportista" android:textColor="@color/texto_secundario"
                            android:textSize="12sp" android:letterSpacing="0.04" />
                        <TextView android:id="@+id/tv_transportista" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Sin asignar"
                            android:textColor="@color/texto_primario" android:textSize="14sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">
                        <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                            android:text="Vehículo" android:textColor="@color/texto_secundario"
                            android:textSize="12sp" android:letterSpacing="0.04" />
                        <TextView android:id="@+id/tv_vehiculo_detalle" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Sin asignar"
                            android:textColor="@color/texto_primario" android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botones de acción -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_mapa"
                style="@style/Widget.Pispax.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_altura"
                android:text="Ver en el mapa"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_aceptar"
                style="@style/Widget.Pispax.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_altura"
                android:text="Aceptar viaje"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_avanzar"
                style="@style/Widget.Pispax.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_altura"
                android:text="Avanzar estado"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_detalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:indeterminateTint="@color/naranja_principal"
                android:layout_gravity="center"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
