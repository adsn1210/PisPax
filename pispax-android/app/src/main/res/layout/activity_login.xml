<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_principal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- HEADER NAVY -->
        <View
            android:id="@+id/view_header"
            android:layout_width="0dp"
            android:layout_height="240dp"
            android:background="@color/navy_secundario"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- NOMBRE DE LA APP -->
        <TextView
            android:id="@+id/tv_login_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PisPax"
            android:textColor="@color/blanco"
            android:textSize="40sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            app:layout_constraintTop_toTopOf="@id/view_header"
            app:layout_constraintBottom_toTopOf="@id/tv_login_claim"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVerticalChainStyle="packed"
            app:layout_constraintVerticalBias="0.44"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_login_claim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transporte inteligente de mercancías"
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.04"
            app:layout_constraintTop_toBottomOf="@id/tv_login_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/view_header" />

        <!-- CARD FORMULARIO flotando sobre el header -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/bg_card"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/view_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="-36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_email"
                    style="@style/Widget.Pispax.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_email_hint">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/texto_primario" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password"
                    style="@style/Widget.Pispax.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_password_hint"
                    android:layout_marginTop="12dp"
                    app:passwordToggleEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/texto_primario" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    style="@style/Widget.Pispax.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_altura"
                    android:text="@string/login_btn"
                    android:layout_marginTop="22dp" />

                <TextView
                    android:id="@+id/tv_registro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_sin_cuenta"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:padding="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/progress_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/naranja_principal"
            app:layout_constraintTop_toBottomOf="@id/card_login"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Toggle tema: esquina superior derecha sobre el header -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_tema"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:icon="@drawable/ic_dark_mode"
            app:iconSize="22dp"
            app:iconTint="#AAFFFFFF"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
